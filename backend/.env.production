# ═══════════════════════════════════════════════════════════════════════════
# Production Environment Configuration
# IMPORTANT: These values are examples - update with actual production values
# This file should NOT be committed to git (add to .gitignore)
# ═══════════════════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection (Recommended for Production)
# Update with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cinebook?retryWrites=true&w=majority

# JWT Configuration - MUST be changed for production!
# Generate a strong random string: https://www.uuidgenerator.net/
JWT_SECRET=your_super_secure_random_secret_key_min_32_chars_here
JWT_EXPIRE=7d

# CORS - Frontend URL for production deployment
# For Vercel: https://your-app.vercel.app
# For Netlify: https://your-app.netlify.app
# For Render: https://your-app.onrender.com
CLIENT_URL=https://your-deployed-frontend-domain.com
