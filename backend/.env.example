# ═══════════════════════════════════════════════════════════════════════════
# CineBook Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database Configuration ───────────────────────────────────────────────────
# MongoDB Atlas (Production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cinebook?retryWrites=true&w=majority

# MongoDB Local (Development)
# MONGO_URI=mongodb://localhost:27017/cinebook

# ─── JWT Configuration ────────────────────────────────────────────────────────
# IMPORTANT: Change these values in production!
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ─── CORS Configuration ───────────────────────────────────────────────────────
# Frontend URL(s) - for production, use your deployed frontend URL
# For multiple URLs, separate with commas: https://app.example.com,https://staging.example.com
CLIENT_URL=https://your-frontend-domain.com

# ─── Development Only ─────────────────────────────────────────────────────────
# Set to true for more verbose logging in development
DEBUG=false

